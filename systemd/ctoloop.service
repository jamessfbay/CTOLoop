[Unit]
Description=CTOLoop GitHub-to-Codex automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/ctoloop
Environment=CTOLOOP_CONFIG=/opt/ctoloop/config.toml
Environment=PATH=/opt/ctoloop/.venv/bin:/usr/local/bin:/usr/bin:/bin
# Ubuntu's AppArmor userns restriction strips the network capability that
# Codex's workspace-write bwrap sandbox needs to initialize loopback. The `+`
# prefix runs only this prerequisite as root; the agent itself remains `ubuntu`.
ExecStartPre=+/usr/sbin/sysctl -w kernel.apparmor_restrict_unprivileged_userns=0
ExecStart=/opt/ctoloop/.venv/bin/ctoloop watch
Restart=on-failure
RestartSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/ctoloop /tmp

[Install]
WantedBy=multi-user.target
